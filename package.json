{
  "name": "@anonyjcy/dsh-plugin-mobile-touch",
  "version": "1.1.0",
  "description": "Mobile & iPad touch optimization plugin for DeepSeek Harness Web GUI with WebKit fast-tap bypass, hover delay elimination, keyboard focus guard, and smooth workspace scrolling",
  "author": "AnonyJcy",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "dsh-touch-adapt": "bin/cli.js",
    "dsh-mobile-touch": "bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnonyJcy/dsh-plugin-mobile-touch.git"
  },
  "bugs": {
    "url": "https://github.com/AnonyJcy/dsh-plugin-mobile-touch/issues"
  },
  "homepage": "https://github.com/AnonyJcy/dsh-plugin-mobile-touch#readme",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./installer": {
      "types": "./lib/installer.d.ts",
      "default": "./lib/installer.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "touch",
    "ipad",
    "mobile",
    "fastclick",
    "tap",
    "cordis-plugin",
    "web-ui"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "status": "node bin/cli.js status",
    "install:plugin": "node bin/cli.js install",
    "uninstall:plugin": "node bin/cli.js uninstall",
    "verify": "node bin/cli.js verify"
  }
}
